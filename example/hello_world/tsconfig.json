{
    "compilerOptions": {
        "target": "esnext",
        "module": "es2022",
        "outDir": "lib",
        "rootDir": "src",
        "sourceMap": true,
        "declaration": true,
        "newLine": "LF",
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "strictBindCallApply": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true,
        "stripInternal": true,
        "types": [
            "node"
        ]
    },
    "skipLibCheck": true,
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}